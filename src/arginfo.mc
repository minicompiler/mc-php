// php's own arity of every builtin mc-php has: "MIN:MAX", MAX -1 for a
// variadic one
uptr ph_argn(uptr n) {
    if (str_eq(n, "abs")) return "1:1";
    if (str_eq(n, "acos")) return "1:1";
    if (str_eq(n, "acosh")) return "1:1";
    if (str_eq(n, "addcslashes")) return "2:2";
    if (str_eq(n, "addslashes")) return "1:1";
    if (str_eq(n, "array_chunk")) return "2:3";
    if (str_eq(n, "array_column")) return "2:3";
    if (str_eq(n, "array_combine")) return "2:2";
    if (str_eq(n, "array_diff")) return "1:-1";
    if (str_eq(n, "array_diff_key")) return "1:-1";
    if (str_eq(n, "array_fill")) return "3:3";
    if (str_eq(n, "array_fill_keys")) return "2:2";
    if (str_eq(n, "array_filter")) return "1:3";
    if (str_eq(n, "array_flip")) return "1:1";
    if (str_eq(n, "array_intersect")) return "1:-1";
    if (str_eq(n, "array_intersect_key")) return "1:-1";
    if (str_eq(n, "array_is_list")) return "1:1";
    if (str_eq(n, "array_key_exists")) return "2:2";
    if (str_eq(n, "array_key_first")) return "1:1";
    if (str_eq(n, "array_key_last")) return "1:1";
    if (str_eq(n, "array_keys")) return "1:3";
    if (str_eq(n, "array_map")) return "2:-1";
    if (str_eq(n, "array_merge")) return "0:-1";
    if (str_eq(n, "array_pad")) return "3:3";
    if (str_eq(n, "array_pop")) return "1:1";
    if (str_eq(n, "array_product")) return "1:1";
    if (str_eq(n, "array_push")) return "1:-1";
    if (str_eq(n, "array_reduce")) return "2:3";
    if (str_eq(n, "array_reverse")) return "1:2";
    if (str_eq(n, "array_search")) return "2:3";
    if (str_eq(n, "array_shift")) return "1:1";
    if (str_eq(n, "array_slice")) return "2:4";
    if (str_eq(n, "array_splice")) return "2:4";
    if (str_eq(n, "array_sum")) return "1:1";
    if (str_eq(n, "array_unique")) return "1:2";
    if (str_eq(n, "array_unshift")) return "1:-1";
    if (str_eq(n, "array_values")) return "1:1";
    if (str_eq(n, "arsort")) return "1:2";
    if (str_eq(n, "asin")) return "1:1";
    if (str_eq(n, "asinh")) return "1:1";
    if (str_eq(n, "asort")) return "1:2";
    if (str_eq(n, "assert")) return "1:2";
    if (str_eq(n, "assert_options")) return "1:2";
    if (str_eq(n, "atan")) return "1:1";
    if (str_eq(n, "atan2")) return "2:2";
