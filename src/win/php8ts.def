; The php names lib/php_ext.mc calls, and the DLL that exports them.
;
; _emalloc is ZEND_FASTCALL, which MSVC builds of php make __vectorcall
; (Zend/zend_portability.h), and a __vectorcall export carries its argument
; bytes in its name: php's DLL exports _emalloc@@8, not _emalloc. The
; convention itself is the ordinary Win64 one for an integer argument, so mc's
; call is right as it is; only the NAME needs the alias, which is what `==`
; says -- the program links to _emalloc, the loader looks up _emalloc@@8.
; _erealloc (a pointer and a size_t, 16 bytes) and _efree (one pointer, 8)
; are the same convention: a string's own block, grown in place and released
; at zero (lib/php_rt.mc § who owns a string), and the call's chunk.
; Measured: without it php refused the module with "The specified procedure
; could not be found". zend_fetch_function_str (a pointer and a size_t) is the
; same convention again: a call through php's function table finds its
; function with it (lib/php_ext.mc's phx_flook).
LIBRARY php8ts.dll
EXPORTS
_emalloc == _emalloc@@8
_erealloc == _erealloc@@16
_efree == _efree@@8
zend_fetch_function_str == zend_fetch_function_str@@16
_zend_new_array == _zend_new_array@@8
zend_hash_update == zend_hash_update@@24
zend_hash_index_update == zend_hash_index_update@@24
zend_hash_internal_pointer_reset_ex == zend_hash_internal_pointer_reset_ex@@16
zend_hash_get_current_key_ex == zend_hash_get_current_key_ex@@32
zend_hash_get_current_data_ex == zend_hash_get_current_data_ex@@16
zend_hash_move_forward_ex == zend_hash_move_forward_ex@@16
instanceof_function_slow == instanceof_function_slow@@16
_call_user_function_impl
object_init_ex
php_output_discard
php_output_end
php_output_flush
php_output_get_contents
php_output_get_length
php_output_get_level
php_output_start_default
php_output_write
zend_argument_count_error
zend_call_known_function
zend_call_method_if_exists
zend_clear_exception
zend_declare_property
zend_get_exception_base
zend_is_callable_ex
zend_lookup_class
zend_lookup_class_ex
zend_read_property
zend_register_internal_class_ex
zend_throw_exception
zend_throw_exception_internal
zend_type_error
zend_update_property
zval_ptr_dtor
