; The php names lib/php_ext.mc calls, and the DLL that exports them.
;
; _emalloc is ZEND_FASTCALL, which MSVC builds of php make __vectorcall
; (Zend/zend_portability.h), and a __vectorcall export carries its argument
; bytes in its name: php's DLL exports _emalloc@@8, not _emalloc. The
; convention itself is the ordinary Win64 one for an integer argument, so mc's
; call is right as it is; only the NAME needs the alias, which is what `==`
; says -- the program links to _emalloc, the loader looks up _emalloc@@8.
; _erealloc (a pointer and a size_t, 16 bytes) and _efree (one pointer, 8)
; are the same convention: a string's own block, grown in place and released
; at zero (lib/php_rt.mc § who owns a string), and the call's chunk.
; Measured: without it php refused the module with "The specified procedure
; could not be found".
LIBRARY php8ts.dll
EXPORTS
_emalloc == _emalloc@@8
_erealloc == _erealloc@@16
_efree == _efree@@8
php_output_discard
php_output_end
php_output_flush
php_output_get_contents
php_output_get_length
php_output_get_level
php_output_start_default
php_output_write
zend_argument_count_error
zend_lookup_class
zend_throw_exception
zend_type_error
